SUPABASE_SERVICE_ROLE_KEY=
# Local: localhost. Producción (Railway): https://webycitas.humanosisu.net — NUNCA localhost en prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp de soporte para CTA "Activar reservas" en /app (solo dígitos o +504…).
# Si vacío, el botón abre mailto con borrador.
NEXT_PUBLIC_SUITE_SUPPORT_WHATSAPP=
RESEND_API_KEY=
RESEND_FROM=Webycitas <noreply@localhost>
NOTIFY_EMAIL=

# Directorio (Mercado Digital de Siguatepeque), servido por esta misma app según el host.
# Host canónico: hoy https://mercado.humanosisu.net, luego https://sigua-online.com. También es build ARG.
# Local: abre http://sigua.localhost:3000 para ver el directorio.
NEXT_PUBLIC_MERCADO_SITE_URL=
MERCADO_RESEND_FROM=Mercado Digital de Siguatepeque <noreply@localhost>
# Hosts extra (coma). Ya incluidos: sigua-online.com, sigua.localhost / mercado.humanosisu.net, www.sigua-online.com
